# ---------- Database (Neon) ----------
# Use the POOLED connection string (host contains "-pooler") from the Neon console.
DATABASE_URL=postgres://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ---------- LLM for article analysis (pipeline only) ----------
# gemini | anthropic | openai | none   (none = use `export`/`import` with any external agent)
LLM_PROVIDER=gemini
# Gemini on Vertex AI (bills your Google Cloud credits). Either an API key bound to a service account:
VERTEX_API_KEY=
# ...or Application Default Credentials (`gcloud auth application-default login`) plus:
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global
# ...or Gemini API (AI Studio) instead of Vertex: unset GOOGLE_CLOUD_PROJECT and set
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_THINKING_LEVEL=LOW      # ~30% cheaper, slightly less accurate names
# ANTHROPIC_API_KEY=            # LLM_PROVIDER=anthropic (ANTHROPIC_MODEL=claude-haiku-5-5)
# OPENAI_API_KEY=               # LLM_PROVIDER=openai, any OpenAI-compatible endpoint
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-5-mini

# ---------- Embeddings (story clustering + semantic search) ----------
# gemini | openai | none. Must be the same provider/model for the pipeline and the API.
EMBEDDING_PROVIDER=gemini
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ---------- Cloudflare R2 image mirror (optional) ----------
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=news-images
# R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev

# ---------- Tuning (optional) ----------
# RETENTION_DAYS=30
# RATE_LIMIT_PER_MINUTE=60      # API, per IP per instance
# CACHE_SECONDS=120             # API CDN cache (s-maxage)
# STORY_AUTO_JOIN=0.9           # cosine similarity to join a story without asking the LLM
# STORY_CANDIDATE_MIN=0.72      # minimum similarity to consider a story a candidate
