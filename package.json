{
  "name": "news-for-agents",
  "version": "0.1.0",
  "private": true,
  "description": "Agent-ready Sri Lankan news graph: pre-fetched, summarized, linked news served as compact JSON.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "news": "tsx src/pipeline/cli.ts",
    "db:migrate": "tsx src/pipeline/cli.ts migrate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@google/genai": "^2.28.0",
    "@hono/node-server": "^2.1.4",
    "@mozilla/readability": "^0.6.0",
    "@neondatabase/serverless": "^1.2.0",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-traversal": "^0.3.1",
    "graphology-types": "^0.24.8",
    "hono": "^4.13.13",
    "linkedom": "^0.18.13",
    "pg": "^8.23.1",
    "rss-parser": "^3.13.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
